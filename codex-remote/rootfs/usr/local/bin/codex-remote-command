#!/usr/bin/env python3
"""Restricted SSH gateway for the isolated Codex add-on."""
import os
import getpass
import shlex
import subprocess
import sys

env = os.environ.copy()
env.update({
    "HOME": "/data/codex-remote",
    "CODEX_HOME": "/data/codex-home",
    "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
    "CODEX_REMOTE_WORKSPACE_ROOT": "/data/workspaces",
})
os.chdir("/data/workspaces")

def run(args):
    os.execve("/usr/local/bin/codex", ["/usr/local/bin/codex", *args], env)

raw = os.environ.get("SSH_ORIGINAL_COMMAND", "").strip()
if not raw:
    if not sys.stdin.isatty():
        sys.exit("Interactive Codex requires an SSH terminal (PTY)")
    actions = {
        "1": ["--no-daemon", "--sandbox", "danger-full-access"],
        "2": ["login", "--device-auth"],
        "3": ["login", "status"],
        "4": ["--version"],
    }
    while True:
        print("\nCodex Remote — isolated Home Assistant add-on", flush=True)
        print("1. Open Codex")
        print("2. Sign in to Codex (device authentication)")
        print("3. Check Codex login status")
        print("4. Show Codex version")
        print("5. Connect GitHub (paste restricted token privately)")
        print("6. Check GitHub login")
        print("7. Exit")
        try:
            choice = input("Choose 1–7: ").strip()
        except (EOFError, KeyboardInterrupt):
            print("\\nGoodbye")
            sys.exit(0)
        if choice == "7":
            sys.exit(0)
        if choice == "5":
            print("Paste your repository-limited GitHub token. Input is hidden.", flush=True)
            try:
                token = getpass.getpass("GitHub token (hidden): ").strip()
                if not token:
                    print("No token entered", flush=True)
                    continue
                result = subprocess.run(
                    ["/usr/bin/gh", "auth", "login", "--hostname", "github.com", "--with-token"],
                    input=token + "\n", text=True, env=env, cwd="/data/workspaces",
                    capture_output=True, check=False, timeout=60,
                )
                token = ""
                if result.returncode == 0:
                    print("GitHub CLI authenticated. Verify with menu option 6.", flush=True)
                else:
                    print(f"GitHub login failed (exit {result.returncode}). Token not displayed.", flush=True)
            except (EOFError, KeyboardInterrupt):
                print("Authentication cancelled", flush=True)
            except (OSError, subprocess.TimeoutExpired) as exc:
                print(f"GitHub login could not complete: {type(exc).__name__}", flush=True)
            continue
        if choice == "6":
            result = subprocess.run(["/usr/bin/gh", "auth", "status"], env=env, cwd="/data/workspaces", check=False)
            print(f"GitHub status exit code: {result.returncode}", flush=True)
            continue
        if choice not in actions:
            print("Invalid selection", flush=True)
            continue
        try:
            result = subprocess.run(["/usr/local/bin/codex", *actions[choice]], env=env, cwd="/data/workspaces", check=False)
            print(f"\nCodex exited with status {result.returncode}", flush=True)
        except OSError as exc:
            print(f"Unable to launch Codex: {exc}", flush=True)
        try:
            input("Press Return to return to the menu...")
        except (EOFError, KeyboardInterrupt):
            sys.exit(0)

try:
    argv = shlex.split(raw)
except ValueError:
    sys.exit("Rejected malformed SSH command")
if not argv or argv[0] not in ("codex", "/usr/local/bin/codex"):
    sys.exit("Only approved Codex remote commands are permitted")
args = argv[1:]
allowed = {
    ("app-server", "daemon", "bootstrap", "--remote-control"),
    ("app-server", "daemon", "start"),
    ("app-server", "daemon", "restart"),
    ("app-server", "daemon", "stop"),
    ("app-server", "daemon", "version"),
    ("app-server", "daemon", "enable-remote-control"),
    ("app-server", "daemon", "disable-remote-control"),
    ("remote-control", "start"),
    ("remote-control", "stop"),
    ("--version",),
    ("login", "--device-auth"),
    ("login", "status"),
}
if tuple(args) not in allowed:
    sys.exit("Rejected SSH command: not on the Codex remote allow-list")
run(args)
